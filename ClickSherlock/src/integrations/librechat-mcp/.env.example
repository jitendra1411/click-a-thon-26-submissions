# ClickHouse connection (redacted example — fill your own values, never commit secrets)
CLICKHOUSE_HOST=sonyliv-ch          # service name on your compose network (or cloud host)
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=sonyliv_metrics
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=sonyliv_v2
CLICKHOUSE_SECURE=false
EXTERNAL_CH_NETWORK=sonyliv-net

# LibreChat
LIBRECHAT_PORT=3080
LIBRECHAT_VERSION=latest

# Generated by `make -f Makefile.portable secrets` — do not hand-write
LC_CREDS_KEY=
LC_CREDS_IV=
LC_JWT_SECRET=
LC_JWT_REFRESH_SECRET=

# Model provider — at least one for the agent to drive MCP tools
DEEPSEEK_API_KEY=sk-REPLACE_ME
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
